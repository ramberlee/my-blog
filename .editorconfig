# EditorConfig - https://editorconfig.org
root = true

# Default settings for all files
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Windows batch scripts need CRLF
[*.bat]
end_of_line = crlf

# PowerShell scripts
[*.ps1]
charset = utf-8
end_of_line = crlf

# Makefiles need tabs
[Makefile]
indent_style = tab
