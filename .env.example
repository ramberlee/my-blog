PORT=3001
NODE_ENV=development
SESSION_EXPIRY_HOURS=24
MAX_UPLOAD_SIZE_MB=5

# 站点公开地址（sitemap / RSS 使用）
SITE_URL=https://ramberlee.github.io/my-blog

# 前端构建时注入的站点地址（index.html 的 og:url / canonical）
VITE_SITE_URL=https://ramberlee.github.io/my-blog/

# 首次初始化时的默认管理员密码（已有数据时不会覆盖）
ADMIN_DEFAULT_PASSWORD=admin123

# Image compression
IMAGE_MAX_WIDTH=1200
IMAGE_QUALITY=80
THUMB_WIDTH=400
THUMB_QUALITY=70

# DeepSeek Harness（DSH）公开地址；本地默认本机 3080
VITE_ASSISTANT_URL=http://127.0.0.1:3080
